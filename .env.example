PORT=3000

# ---------- Telegram ----------
# Token do bot, obtido com o @BotFather
TELEGRAM_BOT_TOKEN=

# URL publica do backend (a do Render), sem barra no final
# Ex: https://boot-mecanico.onrender.com
TELEGRAM_WEBHOOK_URL=

# Opcional: numero do seu chat. Se definido, SO este chat e atendido pelo bot.
# Se ficar vazio, vale o primeiro /start (e depois fica gravado no banco).
TELEGRAM_CHAT_ID=

# ---------- Seguranca do app ----------
# Senha das rotas usadas pelo app (/obd-raw, /obd-live, /obd-data, /simulate, /ultimo).
# O app chama .../obd-live?token=SUA_SENHA. Escolha algo longo e sem espacos.
OBD_TOKEN=

# ---------- Banco de dados (Supabase) ----------
# Sem estas duas, o sistema funciona, mas esquece tudo quando o Render reinicia
# e o controle de combustivel fica desativado.
SUPABASE_URL=
# Chave SECRETA (comeca com sb_secret_). NUNCA use a chave "publishable".
SUPABASE_SECRET_KEY=

# ---------- IA gratuita (opcional) ----------
# So necessario para perguntas livres no Telegram. Chave gratuita em https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
