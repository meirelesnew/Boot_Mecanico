PORT=3000

# OPCIONAL - so necessario se quiser habilitar perguntas livres no Telegram.
# Sem isso, o sistema funciona 100% de graca (tabela fixa de codigos DTC).
# Pegue sua chave gratuita em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opcional - por padrao usa "openrouter/free", que escolhe um modelo
# gratuito automaticamente. So mude se quiser fixar um modelo especifico.
OPENROUTER_MODEL=openrouter/free

# Token do bot, obtido com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN=coloque_o_token_do_bot_aqui

# URL publica do backend (a que o Render/Railway te der), sem barra no final
# Ex: https://obd-backend-xxxx.onrender.com
TELEGRAM_WEBHOOK_URL=

# Opcional: se voce ja souber seu chat_id, pode preencher aqui.
# Caso contrario, mande /start pro bot que ele salva sozinho.
TELEGRAM_CHAT_ID=

# Opcional, mas recomendado: protege a rota /obd-raw (usada pelo app do celular).
# Escolha uma senha longa e aleatoria; o app precisa chamar .../obd-raw?token=SUA_SENHA
OBD_TOKEN=
